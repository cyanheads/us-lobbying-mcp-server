{
  "name": "@cyanheads/us-lobbying-mcp-server",
  "version": "0.1.2",
  "mcpName": "io.github.cyanheads/us-lobbying-mcp-server",
  "description": "Search US lobbying disclosures and foreign-agent registrations via MCP. STDIO or Streamable HTTP.",
  "author": "Casey Hand <casey@caseyjhand.com> (https://caseyjhand.com)",
  "homepage": "https://github.com/cyanheads/us-lobbying-mcp-server#readme",
  "funding": [
    {
      "type": "github",
      "url": "https://github.com/sponsors/cyanheads"
    },
    {
      "type": "buy_me_a_coffee",
      "url": "https://www.buymeacoffee.com/cyanheads"
    }
  ],
  "bugs": {
    "url": "https://github.com/cyanheads/us-lobbying-mcp-server/issues"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "us-lobbying-mcp-server": "dist/index.js"
  },
  "files": [
    "skills/",
    "changelog/",
    "dist/",
    "!dist/*.mcpb",
    "README.md",
    "LICENSE",
    "CLAUDE.md",
    "AGENTS.md",
    "Dockerfile",
    "server.json"
  ],
  "scripts": {
    "build": "bun run scripts/build.ts",
    "rebuild": "bun run scripts/clean.ts && bun run scripts/build.ts",
    "clean": "bun run scripts/clean.ts",
    "devcheck": "bun run scripts/devcheck.ts",
    "audit:fix": "bun audit fix",
    "audit:refresh": "rm -f bun.lock && bun install && bun audit",
    "tree": "bun run scripts/tree.ts",
    "list-skills": "bun run scripts/list-skills.ts",
    "format": "biome check --write .",
    "format:unsafe": "biome check --write --unsafe .",
    "lint:mcp": "bun run scripts/lint-mcp.ts",
    "lint:packaging": "bun run scripts/lint-packaging.ts",
    "bundle": "bun run build && npx -y @anthropic-ai/mcpb pack . dist/us-lobbying-mcp-server.mcpb && bun run scripts/clean-mcpb.ts dist/us-lobbying-mcp-server.mcpb",
    "changelog:build": "bun run scripts/build-changelog.ts",
    "changelog:check": "bun run scripts/build-changelog.ts --check",
    "release:github": "bun run scripts/release-github.ts",
    "publish-mcp": "mcp-publisher login github -token \"$(security find-generic-password -a \"$USER\" -s mcp-publisher-github-pat -w)\" && mcp-publisher publish",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "start": "node dist/index.js",
    "start:stdio": "MCP_TRANSPORT_TYPE=stdio node dist/index.js",
    "start:http": "MCP_TRANSPORT_TYPE=http node dist/index.js"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "lobbying",
    "lda",
    "fara",
    "disclosures",
    "lobbying-disclosure",
    "foreign-agents",
    "government-transparency",
    "open-data",
    "ai-agents",
    "ai-tools",
    "typescript",
    "bun",
    "stdio",
    "streamable-http",
    "cyanheads"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cyanheads/us-lobbying-mcp-server.git"
  },
  "license": "Apache-2.0",
  "packageManager": "bun@1.4.4",
  "engines": {
    "bun": ">=1.4.0",
    "node": ">=24.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@cyanheads/mcp-ts-core": "^0.13.18",
    "@duckdb/node-api": "^2.0.0-r.1",
    "fast-xml-parser": "^5.11.2",
    "fast-xml-validator": "^1.4.2",
    "fflate": "^0.8.3",
    "pino-pretty": "^13.2.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@socketsecurity/bun-security-scanner": "^1.1.3",
    "@types/node": "26.6.5",
    "@vitest/coverage-istanbul": "5.0.5",
    "depcheck": "^1.4.7",
    "fast-check": "^4.10.2",
    "ignore": "^7.0.14",
    "tsc-alias": "^1.9.9",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
